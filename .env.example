# SAP Adaptor Environment Configuration
# Copy this file to .env and fill in your values

# ===== SAP Configuration =====
# Leave empty when using the simulator
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=

# SAP Base URL (default uses simulator service)
SAP_BASE_URL=http://sap-simulator:8081

# ===== Digital Twin Configuration =====
# Use host.docker.internal to reach services on your host machine
DIGITAL_TWIN_BASE_URL=http://host.docker.internal:8082
DIGITAL_TWIN_API_KEY=your-api-key-here

# ===== Optional: Override defaults =====
# SAP_ADAPTOR_SERVER_PORT=8080
# SAP_ADAPTOR_LOG_LEVEL=info
