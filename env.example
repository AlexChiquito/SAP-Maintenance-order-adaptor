# SAP Adaptor Configuration

# Server Configuration
export SAP_ADAPTOR_SERVER_PORT=8080
export SAP_ADAPTOR_SERVER_HOST=0.0.0.0

# SAP Configuration
# For testing with simulator: http://localhost:8081
# For production: https://your-sap-server.com
export SAP_ADAPTOR_SAP_BASE_URL=http://localhost:8081

# SAP Authentication (required only for real SAP, not for simulator)
export SAP_ADAPTOR_SAP_USERNAME=
export SAP_ADAPTOR_SAP_PASSWORD=
export SAP_ADAPTOR_SAP_CLIENT_ID=
export SAP_ADAPTOR_SAP_CLIENT_SECRET=
export SAP_ADAPTOR_SAP_TOKEN_URL=

# SAP Timeout
export SAP_ADAPTOR_SAP_TIMEOUT=30

# Digital Twin Configuration (optional)
export SAP_ADAPTOR_DIGITAL_TWIN_BASE_URL=
export SAP_ADAPTOR_DIGITAL_TWIN_API_KEY=
export SAP_ADAPTOR_DIGITAL_TWIN_TIMEOUT=30

# Logging
export SAP_ADAPTOR_LOG_LEVEL=info

# SAP Simulator Configuration (when running simulator separately)
export SAP_SIMULATOR_PORT=8081
